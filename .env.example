# Скопируйте в .env и заполните EMBEDDER_API_KEY.
# .env НЕ коммитится (.gitignore).

# Ключ RouterAI (https://routerai.ru/settings/keys).
EMBEDDER_API_KEY=

# OpenAI-совместимый base URL. RouterAI: https://routerai.ru/api/v1
EMBEDDER_BASE_URL=https://routerai.ru/api/v1

# Модель эмбеддингов (id из каталога RouterAI).
# Варианты: voyageai/voyage-4-lite, voyageai/voyage-4,
#           google/gemini-embedding-2, intfloat/e5-large-v2, ...
EMBEDDER_MODEL=voyageai/voyage-4-lite

# Размерность выходного вектора (Matryoshka-усечение через `dimensions`).
# voyage-4-lite поддерживает 2048/1024/512/256.
EMBEDDER_DIM=256